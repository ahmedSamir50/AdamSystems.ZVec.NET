<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ZVec.NET</PackageId>
    <AssemblyName>ZVec.NET</AssemblyName>
    <RootNamespace>ZVec.NET</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- XML docs for IntelliSense / future DocFX or XML→markdown API pages. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1574</NoWarn>
    <!-- Version = our SemVer + pinned ZVec native: 1.0.0-beta.5+zvec.0.6.0. TFMs live in TargetFrameworks + lib/, NOT in the version string. -->
    <Version>1.0.0-beta.5+zvec.0.6.0</Version>
    <Authors>Ahmed Samir https://github.com/ahmedSamir50</Authors>
    <Company>Adam Systems EGY</Company>
    <Description>High-performance .NET SDK for Alibaba ZVec — the "SQLite of Vector DBs". Zero-allocation vector pipelines (ReadOnlyMemory&lt;float&gt;), sync + async APIs, DI-first design. Wraps the official zvec_c_api C++ core with idiomatic C#: SafeHandle guarantees, HNSW/IVF/Flat/DiskANN/Vamana/FTS indexes, hybrid search, schema evolution, and cross-platform native binaries.</Description>
    <PackageTags>zvec;vector-database;embeddings;HNSW;semantic-search;RAG;dotnet;alibaba;similarity-search;ann;maui</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>1.0.0-beta.5 wrapping ZVec C++ 0.6.0. Native AOT / IL trimming compatible: typed ODM (IZvecCollection&lt;T&gt;, ZVecMapper, ZVecTypeModel) now uses [DynamicallyAccessedMembers] annotations. Consumer POCOs do not need annotations. Consumers can publish Native AOT with zero IL warnings. See CHANGELOG.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/ahmedSamir50/AdamSystems.ZVec.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ahmedSamir50/AdamSystems.ZVec.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Pack CI sets RepositoryCommit / SourceRevisionId from GITHUB_SHA for nuspec provenance. -->
    <RepositoryCommit Condition="'$(RepositoryCommit)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</SourceRevisionId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="DependencyInjection\" />
    <Folder Include="Builders\" />
    <Folder Include="Interop\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="package-icon.png" Pack="true" PackagePath="package-icon.png" />
    <None Include="runtimes\**\*" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZVec.NET.Tests" PublicKey="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
</Project>
